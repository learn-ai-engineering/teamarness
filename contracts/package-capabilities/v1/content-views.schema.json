{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamarness.dev/contracts/package-capabilities/v1/content-views.schema.json",
  "title": "Content views capability 1.0",
  "description": "A Package states which files in its own Package Data Directory make up a view; the Host resolves, verifies and serves them under teamarness-content://localhost/<view>/<path> with a media type from the shared extension allowlist. Declaring this family is also the Package's opt-in to nesting content frames in its UI mounts. The grant fixes the Package, Workspace and process generation, so no request names a Package and a view ends with the generation.",
  "$defs": {
    "contentPath": {
      "description": "A normalized relative path: non-empty '/'-separated segments, none of them '.' or '..', no '\\\\', NUL, '%', '?', '#' or control characters. The extension of the last segment must be on the allowlist and match lowercase only.",
      "type": "string", "minLength": 1, "maxLength": 128
    },
    "sourcePath": {
      "description": "A normalized relative path inside the caller's Package Data Directory. Symlinks, non-regular files and paths outside the directory are refused.",
      "type": "string", "minLength": 1, "maxLength": 256
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "view": { "description": "The opaque view token: 128 random bits as lowercase hexadecimal.", "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "fileSource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "file" },
        "path": { "$ref": "#/$defs/sourcePath" }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size", "source"],
      "properties": {
        "path": { "$ref": "#/$defs/contentPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "source": { "$ref": "#/$defs/fileSource" }
      }
    },
    "openCall": {
      "description": "Paths are unique, the entry is one of the listed paths, and the declared sizes total at most 67108864 bytes.",
      "type": "object", "additionalProperties": false,
      "required": ["method", "entry", "files"],
      "properties": {
        "method": { "const": "open" },
        "entry": { "$ref": "#/$defs/contentPath" },
        "files": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "openResult": {
      "type": "object", "additionalProperties": false,
      "required": ["view", "url"],
      "properties": {
        "view": { "$ref": "#/$defs/view" },
        "url": { "description": "teamarness-content://localhost/<view>/<entry>, with the entry percent-encoded outside unreserved characters and '/'.", "type": "string", "pattern": "^teamarness-content://localhost/[0-9a-f]{32}/" }
      }
    },
    "closeCall": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "view"],
      "properties": { "method": { "const": "close" }, "view": { "$ref": "#/$defs/view" } }
    },
    "closeResult": {
      "description": "closed is false when the view had already ended or is not this generation's.",
      "type": "object", "additionalProperties": false,
      "required": ["closed"],
      "properties": { "closed": { "type": "boolean" } }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxFiles", "maxTotalBytes", "maxFileBytes", "maxPathBytes", "maxViewsPerGeneration"],
      "properties": {
        "maxFiles": { "const": 1000 },
        "maxTotalBytes": { "const": 67108864 },
        "maxFileBytes": { "const": 16777216 },
        "maxPathBytes": { "const": 128 },
        "maxViewsPerGeneration": { "const": 32 }
      }
    },
    "mediaTypes": {
      "description": "The shared extension allowlist. Extensions match lowercase only.",
      "const": {
        "html": "text/html; charset=utf-8",
        "css": "text/css; charset=utf-8",
        "js": "text/javascript; charset=utf-8",
        "mjs": "text/javascript; charset=utf-8",
        "json": "application/json",
        "svg": "image/svg+xml",
        "png": "image/png",
        "jpg": "image/jpeg",
        "gif": "image/gif",
        "webp": "image/webp",
        "avif": "image/avif",
        "ico": "image/x-icon",
        "woff": "font/woff",
        "woff2": "font/woff2",
        "ttf": "font/ttf",
        "otf": "font/otf",
        "wasm": "application/wasm",
        "txt": "text/plain; charset=utf-8",
        "md": "text/markdown; charset=utf-8",
        "csv": "text/csv; charset=utf-8",
        "mp4": "video/mp4",
        "webm": "video/webm",
        "mp3": "audio/mpeg"
      }
    },
    "errorCodes": { "enum": ["unsupported_media_type", "content_too_large", "invalid_content_path", "capability_request_invalid", "capability_unavailable"] }
  }
}
