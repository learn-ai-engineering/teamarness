{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamarness.dev/contracts/package-capabilities/v1/person-names.schema.json",
  "title": "Workspace Person names capability 1.0",
  "description": "Presentation only, never membership authority. The cursor is a durable coalescing profile generation, not a membership epoch or record cursor. Resume by refetching the latest snapshot.",
  "$defs": {
    "cursor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "workspaceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "personId", "name", "fingerprint"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "personId": { "$ref": "#/$defs/identity" },
        "name": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] },
        "fingerprint": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "cursor", "persons"],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "cursor": { "$ref": "#/$defs/cursor" },
        "persons": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/person" } }
      }
    },
    "currentCall": { "type": "object", "additionalProperties": false, "required": ["method"], "properties": { "method": { "const": "current" } } },
    "lookupCall": { "type": "object", "additionalProperties": false, "required": ["method", "identity"], "properties": { "method": { "const": "lookup" }, "identity": { "$ref": "#/$defs/identity" } } },
    "lookupResult": { "type": "object", "additionalProperties": false, "required": ["person"], "properties": { "person": { "anyOf": [{ "$ref": "#/$defs/person" }, { "type": "null" }] } } },
    "subscribe": { "type": "object", "additionalProperties": false, "required": ["grant", "method", "afterCursor"], "properties": { "grant": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }, "method": { "const": "subscribe" }, "afterCursor": { "$ref": "#/$defs/cursor" } } }
  }
}
