{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamarness.dev/contracts/package-process/v1/lifecycle.schema.json",
  "title": "Package lifecycle request v1",
  "allOf": [
    { "$ref": "frame.schema.json#/$defs/request" },
    {
      "required": ["operation"],
      "properties": {
        "id": { "pattern": "^h:" },
        "operation": {
          "enum": [
            "lifecycle.activate",
            "lifecycle.suspend",
            "lifecycle.recover",
            "lifecycle.dispose"
          ]
        }
      }
    }
  ]
}
