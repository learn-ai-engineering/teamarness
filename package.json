{
  "name": "teamarness",
  "private": true,
  "workspaces": ["apps/teamarness-desktop"],
  "scripts": {
    "dev": "node scripts/dev-profile.mjs dev",
    "dev:instance": "node scripts/dev-profile.mjs instance",
    "build": "npm --workspace teamarness-desktop run build",
    "typecheck": "npm --workspace teamarness-desktop run typecheck",
    "lint": "npm --workspace teamarness-desktop run lint",
    "test": "node --test scripts/dev-profile.test.mjs contracts/package-process/v1/fixtures/*.test.mjs && npm --workspace teamarness-desktop test",
    "test:dev-profile": "node --test scripts/dev-profile.test.mjs",
    "tauri": "npm --workspace teamarness-desktop run tauri --"
  }
}
