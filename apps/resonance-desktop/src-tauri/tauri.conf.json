{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance",
  "version": "0.1.0",
  "identifier": "dev.resonance.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Resonance",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity"
  }
}
