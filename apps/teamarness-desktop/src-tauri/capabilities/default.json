{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-shell",
  "description": "Bundled Teamarness Shell webview only",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-installation-details",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-create-workspace-invitation",
    "allow-join-workspace",
    "allow-current-membership",
    "allow-principals-snapshot",
    "allow-subscribe-principals",
    "allow-rename-workspace-principal",
    "allow-add-workspace-agent",
    "allow-remove-workspace-agent",
    "allow-package-catalog-snapshot",
    "allow-package-subscribe-host-state",
    "allow-package-open-mount",
    "allow-package-close-mount",
    "allow-package-request",
    "allow-package-cancel-request",
    "allow-package-open-stream",
    "allow-package-acknowledge-events",
    "allow-package-close-stream",
    "allow-package-suspend",
    "allow-package-recover",
    "allow-package-dispose",
    "allow-package-report-ui-fault"
  ]
}
