{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teamarness",
  "version": "0.1.0",
  "identifier": "dev.teamarness.desktop",
  "build": {
    "beforeDevCommand": "npm run build:application-packages && npm run build:frame-runtime && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:application-packages && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; frame-src teamarness-package:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Teamarness",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A local-first peer-to-peer team workspace",
    "longDescription": "Create a Teamarness Workspace and admit another Installation through peer-to-peer onboarding.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../../packages/application-packages.v1.json": "packages/application-packages.v1.json",
      "../../../target/teamarness-packages/dev.teamarness.reference/": "packages/dev.teamarness.reference/",
      "../../../target/teamarness-packages/dev.teamarness.tutorial/": "packages/dev.teamarness.tutorial/",
      "../../../target/teamarness-packages/dev.teamarness.conversations/": "packages/dev.teamarness.conversations/",
      "../../../target/teamarness-packages/dev.teamarness.repo-aware/": "packages/dev.teamarness.repo-aware/",
      "../../../target/teamarness-packages/dev.teamarness.documents/": "packages/dev.teamarness.documents/",
      "../../../target/teamarness-packages/dev.teamarness.exhibits/": "packages/dev.teamarness.exhibits/"
    },
    "externalBin": [
      "../../../target/teamarness-packages/dev.teamarness.reference/backend/teamarness-reference-package",
      "../../../target/teamarness-packages/dev.teamarness.tutorial/backend/teamarness-tutorial-package",
      "../../../target/teamarness-packages/dev.teamarness.conversations/backend/teamarness-conversations-package",
      "../../../target/teamarness-packages/dev.teamarness.repo-aware/backend/teamarness-repo-aware-package",
      "../../../target/teamarness-packages/dev.teamarness.documents/backend/teamarness-documents-package",
      "../../../target/teamarness-packages/dev.teamarness.exhibits/backend/teamarness-exhibits-package"
    ]
  }
}