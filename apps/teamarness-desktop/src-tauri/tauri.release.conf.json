{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "features": ["production-release"],
    "beforeBuildCommand": "node ../../scripts/build-application-packages.mjs --release && npm run build"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "externalBin": [],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/learn-ai-engineering/teamarness/releases/latest/download/latest.json"]
    }
  }
}
