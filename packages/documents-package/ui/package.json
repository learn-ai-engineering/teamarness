{
  "name": "@teamarness/documents-package-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "contract-types": "teamarness-contract-types --contract ../ui-contract.json --out src/contract.generated.ts --type-name DocumentsContract",
    "typecheck": "teamarness-contract-types --contract ../ui-contract.json --out src/contract.generated.ts --type-name DocumentsContract --check && tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@teamarness/package-ui-sdk": "0.1.0",
    "dompurify": "3.2.6",
    "loro-crdt": "1.16.2",
    "loro-prosemirror": "0.4.4",
    "markdown-it": "14.1.0",
    "prosemirror-model": "1.25.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/dompurify": "3.2.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "happy-dom": "20.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
