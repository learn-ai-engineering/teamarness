{
  "schemaVersion": 1,
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(.*\\S)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(.*\\S)?$"
    },
    "availability": {
      "type": "string",
      "enum": [
        "waiting_for_history_access",
        "offline",
        "catching_up",
        "current"
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "archived"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "archived": {
          "type": "boolean"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "collectionId",
        "title",
        "archived"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "collectionId": {
          "$ref": "#/$defs/recordId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "archived": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collections",
        "documents",
        "availability"
      ],
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "appended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "id"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "id": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "collectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectionId"
      ],
      "properties": {
        "collectionId": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "documentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "requestStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "inclusion",
        "durability"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "inclusion": {
          "enum": [
            "included",
            "absent",
            "unresolved"
          ]
        },
        "durability": {
          "enum": [
            "durable",
            "pending",
            "unresolved"
          ]
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentId",
        "author",
        "position",
        "resolved",
        "isLocal"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "documentId": {
          "$ref": "#/$defs/recordId"
        },
        "parentId": {
          "$ref": "#/$defs/recordId"
        },
        "author": {
          "type": "string"
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "boolean"
        },
        "isLocal": {
          "type": "boolean"
        },
        "markdown": {
          "type": "string",
          "maxLength": 32768
        },
        "quote": {
          "type": "string",
          "maxLength": 2048
        },
        "createdAt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,14})$"
        }
      }
    },
    "comments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comments"
      ],
      "properties": {
        "comments": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "commentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commentId"
      ],
      "properties": {
        "commentId": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "personName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "personId",
        "name",
        "fingerprint"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "personId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "cursor",
        "persons"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "cursor": {
          "$ref": "#/$defs/revision"
        },
        "persons": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/personName"
          }
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "parts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "sessionPeer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "bodyReason": {
      "type": "string",
      "enum": [
        "identity_conflict",
        "import_failure"
      ]
    },
    "bodyState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "editable"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/recordId"
        },
        "editable": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/bodyReason"
        },
        "diagnosticRecordId": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "sessionEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "documentId",
            "sessionPeer",
            "version",
            "editable",
            "chunks"
          ],
          "properties": {
            "event": {
              "const": "begin"
            },
            "documentId": {
              "$ref": "#/$defs/recordId"
            },
            "sessionPeer": {
              "$ref": "#/$defs/sessionPeer"
            },
            "version": {
              "$ref": "#/$defs/revision"
            },
            "editable": {
              "type": "boolean"
            },
            "reason": {
              "$ref": "#/$defs/bodyReason"
            },
            "diagnosticRecordId": {
              "$ref": "#/$defs/recordId"
            },
            "chunks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "documentId",
            "chunkIndex",
            "chunk"
          ],
          "properties": {
            "event": {
              "const": "chunk"
            },
            "documentId": {
              "$ref": "#/$defs/recordId"
            },
            "chunkIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "chunk": {
              "type": "string",
              "maxLength": 24576,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "documentId"
          ],
          "properties": {
            "event": {
              "const": "end"
            },
            "documentId": {
              "$ref": "#/$defs/recordId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "documentId",
            "update"
          ],
          "properties": {
            "event": {
              "const": "update"
            },
            "documentId": {
              "$ref": "#/$defs/recordId"
            },
            "update": {
              "type": "string",
              "maxLength": 218456,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "documentId",
            "durable",
            "editable"
          ],
          "properties": {
            "event": {
              "const": "status"
            },
            "documentId": {
              "$ref": "#/$defs/recordId"
            },
            "durable": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/requestId"
              }
            },
            "editable": {
              "type": "boolean"
            },
            "reason": {
              "$ref": "#/$defs/bodyReason"
            },
            "diagnosticRecordId": {
              "$ref": "#/$defs/recordId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "documentId"
          ],
          "properties": {
            "event": {
              "const": "resync"
            },
            "documentId": {
              "$ref": "#/$defs/recordId"
            }
          }
        }
      ]
    }
  },
  "requests": {
    "documents.snapshot": {
      "request": {
        "type": "object",
        "additionalProperties": false
      },
      "response": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "documents.collection.create": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.collection.rename": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collectionId",
          "name"
        ],
        "properties": {
          "collectionId": {
            "$ref": "#/$defs/recordId"
          },
          "name": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.collection.archive": {
      "request": {
        "$ref": "#/$defs/collectionRequest"
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.collection.restore": {
      "request": {
        "$ref": "#/$defs/collectionRequest"
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.document.create": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collectionId",
          "title"
        ],
        "properties": {
          "collectionId": {
            "$ref": "#/$defs/recordId"
          },
          "title": {
            "$ref": "#/$defs/title"
          }
        }
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.document.rename": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "title"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "title": {
            "$ref": "#/$defs/title"
          }
        }
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.document.move": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "collectionId"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "collectionId": {
            "$ref": "#/$defs/recordId"
          }
        }
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.document.archive": {
      "request": {
        "$ref": "#/$defs/documentRequest"
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.document.restore": {
      "request": {
        "$ref": "#/$defs/documentRequest"
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.document.open": {
      "request": {
        "$ref": "#/$defs/documentRequest"
      },
      "response": {
        "$ref": "#/$defs/bodyState"
      }
    },
    "documents.document.recover": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "requestIds"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "requestIds": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/requestId"
            }
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "requestStatuses"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "requestStatuses": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/requestStatus"
            }
          }
        }
      }
    },
    "documents.document.update": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "sessionPeer",
          "requestId",
          "update"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "sessionPeer": {
            "$ref": "#/$defs/sessionPeer"
          },
          "requestId": {
            "$ref": "#/$defs/requestId"
          },
          "update": {
            "type": "string",
            "maxLength": 218456,
            "pattern": "^[A-Za-z0-9+/]*={0,2}$",
            "minLength": 4
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/$defs/requestId"
          }
        }
      }
    },
    "documents.document.markdown": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "chunkIndex"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "chunkIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "digest",
          "chunks",
          "chunkIndex",
          "chunk"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "chunks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "chunkIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "chunk": {
            "type": "string",
            "maxLength": 24576
          }
        }
      }
    },
    "documents.comments": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "response": {
        "$ref": "#/$defs/comments"
      }
    },
    "documents.comment.add": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "markdown"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "parentId": {
            "$ref": "#/$defs/recordId"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.comment.resolve": {
      "request": {
        "$ref": "#/$defs/commentRequest"
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    },
    "documents.comment.reopen": {
      "request": {
        "$ref": "#/$defs/commentRequest"
      },
      "response": {
        "$ref": "#/$defs/appended"
      }
    }
  },
  "subscriptions": {
    "documents.changes": {
      "request": {
        "type": "object",
        "additionalProperties": false
      },
      "event": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "documents.document.session": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId"
        ],
        "properties": {
          "documentId": {
            "$ref": "#/$defs/recordId"
          },
          "resumePeer": {
            "$ref": "#/$defs/sessionPeer"
          }
        }
      },
      "event": {
        "$ref": "#/$defs/sessionEvent"
      }
    },
    "documents.names": {
      "request": {
        "type": "object",
        "additionalProperties": false
      },
      "event": {
        "$ref": "#/$defs/names"
      }
    }
  }
}
