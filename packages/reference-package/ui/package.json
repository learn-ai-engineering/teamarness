{
  "name": "@teamarness/reference-package-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "contract-types": "teamarness-contract-types --contract ../ui-contract.json --out src/contract.generated.ts --type-name ReferenceContract",
    "typecheck": "teamarness-contract-types --contract ../ui-contract.json --out src/contract.generated.ts --type-name ReferenceContract --check && tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@teamarness/package-ui-sdk": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
